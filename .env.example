# ============================================================
# GİZLİ — bu dosya .gitignore'da, asla commit edilmez.
# ============================================================

# ─── MIA / Kloudeks ─────────────────────────────────────────
# TEK anahtar, üç model. Aşağıdaki satırda = işaretinden sonra yapıştırın:
MIA_API_KEY=

LLM_BASE_URL=https://mia.csp.kloudeks.com/v1
LLM_API_KEY=${MIA_API_KEY}
LLM_MODEL=kkbhackathon2026/Qwen3.8-27B
LLM_DISABLE_THINKING=true
# Sağlayıcı başına en uzun tek çağrı; narration sınırının altında olmamalı.
LLM_TIMEOUT=100
# Açık analiz anlatımının tüm retry'ları için üst süre (doğrulanmış tabloyu etkilemez).
LLM_NARRATION_TIMEOUT_S=100
# Sağlayıcı doğrulanmış anlatımda akışı destekliyorsa TTFT ölçümü için açılabilir; varsayılan kapalı.
LLM_STREAM_NARRATION=false
# Araç planlama/argüman turlarının retry'larla birlikte toplam üst süresi.
LLM_TOOL_TIMEOUT_S=90
# Nihai anlatı turunun sıcaklığı; araç turları hep 0. Golden/kabul betiği 0'a zorlar (ADR-0046).
LLM_NARRATE_TEMPERATURE=0.5

EMBEDDING_MODEL=kkbhackathon2026/Qwen3-Embedding-8B
VISION_MODEL=kkbhackathon2026/Unlimited-OCR
RERANKER_MODEL=

# ─── Web search (provider bağımsız; boş bırakılan provider zincirden düşer) ──
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ─── Yerel geliştirme (Ollama) — MIA yerine kullanmak için üsttekileri
#     yorumlayıp bunları açın ────────────────────────────────
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# ─── Alan profili (opsiyonel) ───────────────────────────────
DOMAIN_DESCRIPTION=
DOMAIN_AUDIENCE=

# ─── Veri kaynakları ────────────────────────────────────────
EVDS_API_KEY=

# ─── Lakehouse ──────────────────────────────────────────────
# --- Yollar (M01): hepsi DATA_ROOT altında; göreli yollar repo köküne göre. Gizli değer yok.
# DATA_ROOT=data
# LAKEHOUSE_PATH=data/lakehouse.duckdb
# LAKEHOUSE_MODE=demo            # demo: Silver şart, yoksa açık nedenle durur · seed: geliştirme · auto: dene-düş
# LAKEHOUSE_CORE_DIR=lakehouse-core
# LAKEHOUSE_CLI=uv run python
# INGEST_ALLOWED_ROOT=data/incoming
# CHART_DIR=data/charts
# GEO_DIR=agent-core/assets/geo
LAKEHOUSE_PATH=data/lakehouse.duckdb

# ─── Web araması (Tavily; ücretsiz katman ayda 1.000 kredi, basic arama 1 kredi) ───
# Anahtar yoksa web_search aracı kayıt edilmez; agent "arama kapalı" der, taklit etmez.
TAVILY_API_KEY=
# Süreç başına arama üst sınırı (golden döngüsü krediyi bitirmesin); demo günü yükseltilir.
WEB_SEARCH_BUDGET=20

# ─── Retrieval kademesi ve araç kapısı (ADR-0043) ───────────────────────────
# auto: katalog ≤ RETRIEVAL_SMALL_MAX → hepsi ön-yüklenir; ≥ RETRIEVAL_HYBRID_MIN ve EMBEDDING_MODEL varsa hibrit; arası yüzlü BM25.
RETRIEVAL_MODE=auto
RETRIEVAL_SMALL_MAX=60
RETRIEVAL_HYBRID_MIN=5000
# Katalog vektörleri (hibrit) buraya önbelleklenir; data/ gitignore'da.
EMBEDDING_CACHE_DIR=agent-core/data/cache/embeddings
# Soruya göre araç alt kümesi; ölçüm için off.
TOOL_GATE=on

# Arayüz (python -m kkb_agent.serve); yerel demo, kimlik yok.
WEB_HOST=127.0.0.1
WEB_PORT=8765

# Profil (M04, ADR-0056): analyst = yazma araçları yok; architect = ingest/terfi/tam sıfırlama.
# Oturumda profil geçişi yalnız ARCHITECT_TOKEN ile; boş bırakılırsa geçiş kapalı (profil başlatmada seçilir).
AGENT_PROFILE=analyst
ARCHITECT_TOKEN=
