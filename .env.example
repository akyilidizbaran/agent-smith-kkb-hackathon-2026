# ============================================================
# Bu dosya ŞABLONDUR. Gerçek değerleri .env içine yazın.
# .env dosyası .gitignore'dadır ve ASLA commit edilmemelidir.
# ============================================================

# --- LLM sağlayıcı ---
# Geliştirme: yerel Ollama (OpenAI-uyumlu endpoint)
# Demo:       Kloudeks (sadece bu iki değer değişir)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# Reasoning modellerinde düşünce zincirini kapatır (hız için). Kalite düşerse false yapın.
LLM_DISABLE_THINKING=true

# Kloudeks'e geçerken:
# LLM_BASE_URL=https://<kloudeks-endpoint>/v1
# LLM_API_KEY=<takıma özel key — kimseyle paylaşmayın>
# LLM_MODEL=<deepseek-...>

# Embedding / reranker / VLM (Kloudeks'te ayrı model adları olacak)
EMBEDDING_MODEL=
RERANKER_MODEL=
VISION_MODEL=

# --- Veri kaynakları ---
# TCMB EVDS: evds2.tcmb.gov.tr üzerinden ücretsiz hesapla alınır.
# 2024-04-05'ten beri key URL'de DEĞİL, HTTP header'ında gönderilir.
EVDS_API_KEY=

# --- Lakehouse ---
# Data ekibi hazır olunca burası onların üretim yoluna işaret edecek.
LAKEHOUSE_PATH=data/lakehouse.duckdb
