@@ -0,0 +1,112 @@
+"""Block C experiment runner — golden set under different harness configurations.
+
+Each configuration is a set of KKB_EXP_* environment flags read by the (experimental) harness.
+For every config the golden set is run `--repeat` times; we report pass^k, mean seconds,
+mean tool steps, mean LLM turns and mean tokens per case.
+
+    python scripts/run_experiments.py --repeat 3 --out ../../docs_experiments_blockC.md
+    python scripts/run_experiments.py --only baseline,preload --repeat 1
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import statistics
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from tests.golden.cases import CASES  # noqa: E402
+
+_S = {"KKB_EXP_GROUND": "shadow"}   # grounding gölge modda her konfigde ölçülür (E5 yanlış pozitif oranı)
+CONFIGS: dict[str, dict[str, str]] = {
+    "baseline": {**_S},
+    "preload": {**_S, "KKB_EXP_PRELOAD": "1"},
+    "parallel": {**_S, "KKB_EXP_PARALLEL": "1"},
+    "preload+parallel": {**_S, "KKB_EXP_PRELOAD": "1", "KKB_EXP_PARALLEL": "1"},
+    "preload+parallel+short": {**_S, "KKB_EXP_PRELOAD": "1", "KKB_EXP_PARALLEL": "1", "KKB_EXP_SHORT": "1"},
+    "preload+parallel+ground": {"KKB_EXP_PRELOAD": "1", "KKB_EXP_PARALLEL": "1", "KKB_EXP_GROUND": "enforce"},
+    "preload+parallel+escalate": {**_S, "KKB_EXP_PRELOAD": "1", "KKB_EXP_PARALLEL": "1", "KKB_EXP_ESCALATE": "1"},
+}
+ALL_FLAGS = ["KKB_EXP_PRELOAD", "KKB_EXP_PARALLEL", "KKB_EXP_SHORT", "KKB_EXP_GROUND", "KKB_EXP_ESCALATE"]
+
+
+def run_config(name: str, flags: dict[str, str], repeat: int, case_ids: list[str] | None) -> dict:
+    for f in ALL_FLAGS:
+        os.environ.pop(f, None)
+    os.environ.update(flags)
+    # re-import so build_agent sees the flags at construction time
+    import importlib
+    import kkb_agent.core.agent as agent_mod
+    import kkb_agent.cli as cli_mod
+    importlib.reload(agent_mod)
+    importlib.reload(cli_mod)
+    from scripts.run_golden import run_case  # noqa: WPS433
+    importlib.reload(sys.modules["scripts.run_golden"])
+    from scripts.run_golden import run_case  # noqa: F811
+
+    cases = [c for c in CASES if not case_ids or c.id in case_ids]
+    per_case: dict[str, dict] = {}
+    for case in cases:
+        rec = {"passed": 0, "runs": 0, "secs": [], "steps": [], "turns": [], "tokens": [], "fails": [], "ground": []}
+        for _ in range(repeat):
+            try:
+                o = run_case(case)
+                rec["passed"] += int(o.passed)
+                rec["secs"].append(o.duration_s)
+                rec["steps"].append(o.steps)
+                extra = getattr(o, "extra", {}) or {}
+                rec["turns"].append(extra.get("llm_turns", 0))
+                rec["tokens"].append(extra.get("tokens", 0))
+                rec["ground"].append(extra.get("grounding", ""))
+                rec["fails"] += o.failures
+            except Exception as exc:  # noqa: BLE001
+                rec["fails"].append(f"{type(exc).__name__}: {exc}")
+                rec["secs"].append(0.0)
+            rec["runs"] += 1
+        per_case[case.id] = rec
+        print(f"  [{name}] {case.id}: {rec['passed']}/{rec['runs']} "
+              f"{statistics.mean(rec['secs']):.1f}s steps={rec['steps']} turns={rec['turns']}")
+    return per_case
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repeat", type=int, default=1)
+    ap.add_argument("--only", default="")
+    ap.add_argument("--cases", default="")
+    ap.add_argument("--out", default="experiments_blockC.md")
+    args = ap.parse_args()
+    selected = [s for s in args.only.split(",") if s] or list(CONFIGS)
+    case_ids = [s for s in args.cases.split(",") if s] or None
+
+    rows = ["# Blok C — harness konfigürasyon deneyleri (golden set)", "",
+            f"repeat={args.repeat} · vaka={len(case_ids) if case_ids else len(CASES)} · model={os.environ.get('LLM_MODEL')}", "",
+            "| Konfig | pass^k | ort. s/vaka | ort. araç adımı | ort. LLM turu | ort. token | grounding (gölge) |", "|---|---|---|---|---|---|---|"]
+    detail = []
+    for name in selected:
+        print(f"\n=== {name} {CONFIGS[name]}")
+        t0 = time.perf_counter()
+        pc = run_config(name, CONFIGS[name], args.repeat, case_ids)
+        total = sum(r["runs"] for r in pc.values())
+        passed = sum(r["passed"] for r in pc.values())
+        allpass = sum(1 for r in pc.values() if r["passed"] == r["runs"])
+        secs = statistics.mean([statistics.mean(r["secs"]) for r in pc.values()])
+        steps = statistics.mean([statistics.mean(r["steps"]) for r in pc.values() if r["steps"]])
+        turns = statistics.mean([statistics.mean(r["turns"]) for r in pc.values() if r["turns"]])
+        toks = statistics.mean([statistics.mean(r["tokens"]) for r in pc.values() if r["tokens"]])
+        ground = [g for r in pc.values() for g in r["ground"] if g]
+        gsum = f"{sum(1 for g in ground if g.startswith('OK'))}/{len(ground)} temiz" if ground else "-"
+        rows.append(f"| {name} | {allpass}/{len(pc)} vaka (koşu {passed}/{total}) | {secs:.1f} | {steps:.1f} | {turns:.1f} | {toks:.0f} | {gsum} |")
+        detail.append(f"\n<details><summary>{name} ayrıntı</summary>\n\n```json\n{json.dumps(pc, ensure_ascii=False, indent=1)[:6000]}\n```\n</details>")
+        print(rows[-1], f"({time.perf_counter() - t0:.0f}s)")
+    Path(args.out).write_text("\n".join(rows + detail) + "\n", encoding="utf-8")
+    print("wrote", args.out)
+
+
+if __name__ == "__main__":
+    main()
