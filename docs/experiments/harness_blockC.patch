+    # ayrı sayılar olarak çıkar; yıl/gün filtresi onları eler.
+    _NUM_RE = re.compile(r"(?<![\w.,])[-+]?\d{1,3}(?:\.\d{3})+(?:,\d+)?|(?<![\w.,])[-+]?\d+(?:[.,]\d+)?")
+
+    @classmethod
+    def _numbers_in(cls, text: str) -> list[float]:
+        out: list[float] = []
+        for m in cls._NUM_RE.finditer(text or ""):
+            raw = m.group(0)
+            # Türkçe biçim: 678.970 (binlik) · 1,5 (ondalık) · 678.970,25 · İngilizce 678970.25
+            if "," in raw:
+                raw = raw.replace(".", "").replace(",", ".")
+            elif raw.count(".") > 1 or re.fullmatch(r"[-+]?\d{1,3}(\.\d{3})+", raw):
+                raw = raw.replace(".", "")
+            try:
+                out.append(float(raw))
+            except ValueError:
