     return AnalyticsAgent(
-        llm, registry, workspace=workspace, max_steps=max_steps, profile=profile
+        llm, registry, workspace=workspace, max_steps=max_steps, profile=profile,
+        context_preload=preload,
     )
 
 
+def build_context_preload(lakehouse: DuckDBLakehouse, max_values: int = 120) -> str:
+    """E4a: katalog kartları + kırılım kolonlarının gerçek değerleri, tek metin.
+
+    ADR-0013'ün 'bağlam ön-yükleme' fikrinin deterministik uygulaması: keşif
+    turları (search/describe/distinct_values) LLM turu olmaktan çıkar. E8 ölçümü
+    (10 Eylül): ~6k token'a kadar katalog prompt'ta doğruluğu düşürmüyor; bu
+    seed'de 1 tablo + 63 kalem ≈ 2k token.
+    """
+    from .contracts.catalog import ColumnRole
+
+    parts: list[str] = []
+    for spec in lakehouse.list_datasets():
+        parts.append(spec.to_prompt_card())
+        for col in spec.columns:
+            if col.role != ColumnRole.DIMENSION or col.dtype.upper() not in ("VARCHAR", "TEXT", "STRING"):
+                continue
+            has_flag = spec.column("is_alt_toplam") is not None
+            select = f"{col.name}, is_alt_toplam" if has_flag else col.name
+            try:
+                res = lakehouse.execute_sql(
+                    f"SELECT DISTINCT {select} FROM {spec.dataset_id} ORDER BY 1 LIMIT {max_values + 1}"
+                )
+            except Exception:  # noqa: BLE001
+                continue
+            df = res.data
+            lines = [f"'{col.name}' kolonundaki GERÇEK değerler ({min(len(df), max_values)} adet; filtrede birebir kullan):"]
+            for row in df.head(max_values).itertuples(index=False):
+                flag = "   ⚠ ALT TOPLAM (alt kalemlerle toplama)" if has_flag and bool(row[1]) else ""
+                lines.append(f"  - {row[0]}{flag}")
+            if len(df) > max_values:
+                lines.append(f"  … (+{len(df) - max_values}; tam liste için lakehouse_distinct_values)")
+            parts.append("\n".join(lines))
+    return "\n\n".join(parts)
+
+
 def main() -> None:
     parser = argparse.ArgumentParser(description="KKB Agentic Analytics Engine")
     parser.add_argument("question", nargs="*", help="Sorulacak soru")
